# Repo-managed Ghostty configuration.
# Live path on macOS: ~/Library/Application Support/com.mitchellh.ghostty/config.ghostty

# Catppuccin stays consistent across Ghostty, Herdr, and reviewr.
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
font-family = SF Mono
font-size = 14
font-thicken = true
cursor-style = bar
cursor-style-blink = false

window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-decoration = auto
background-opacity = 0.94
background-blur = macos-glass-regular
macos-titlebar-style = transparent
unfocused-split-opacity = 0.84

# A static, low-intensity edge treatment adds atmosphere without moving text.
custom-shader = shaders/ghosty-glass.glsl
custom-shader-animation = false

shell-integration = zsh
macos-option-as-alt = true
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

keybind = global:cmd+ctrl+enter=toggle_quick_terminal
keybind = cmd+shift+o=toggle_background_opacity
